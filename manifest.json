{
  "manifest_version": 3,
  "name": "locally",
  "version": "1.0.0",
  "description": "Collect local businesses while you scroll Google Maps, then find emails on their websites.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting", "sidePanel"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "locally",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://www.google.ae/maps*",
        "https://www.google.co.uk/maps*",
        "https://www.google.ca/maps*",
        "https://www.google.com.au/maps*",
        "https://www.google.de/maps*",
        "https://www.google.fr/maps*",
        "https://www.google.es/maps*",
        "https://www.google.it/maps*",
        "https://www.google.nl/maps*",
        "https://www.google.com.eg/maps*",
        "https://www.google.com.sa/maps*",
        "https://www.google.com.tr/maps*",
        "https://www.google.co.in/maps*",
        "https://www.google.com.pk/maps*",
        "https://www.google.com.br/maps*",
        "https://www.google.co.za/maps*",
        "https://www.google.com.mx/maps*",
        "https://www.google.com.sg/maps*",
        "https://www.google.co.jp/maps*",
        "https://maps.google.com/*"
      ],
      "js": ["lib/parse-lead.js", "content/maps.js"],
      "run_at": "document_idle"
    }
  ]
}
